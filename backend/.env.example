DATABASE_URL=sqlite:///./data/security.db
SECRET_KEY=your-secret-key-change-in-production
CORS_ORIGINS=https://controlops.co.uk,http://localhost:3000
FRONTEND_URL=https://controlops.co.uk
API_PUBLIC_URL=https://api.controlops.co.uk

STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_APPLICATION_FEE_PERCENT=0
STRIPE_YEARLY_DISCOUNT_COUPON_ID=
PAYMENT_FAILED_LOCK_RETRIES=3

MAIL_SERVER=host.docker.internal
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=noreply@controlops.co.uk
MAIL_PASSWORD=
MAIL_FROM=noreply@controlops.co.uk
MAIL_FROM_NAME=ControlOps

# Login brute-force protection (account lockout)
LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=3
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

# ---------------------------------------------------------------------------
# Social sign-in (Google / Microsoft / Apple)
# Leave a provider blank to disable that button until credentials are set.
# Redirect URIs must match EXACTLY what you register in each provider console.
# Default redirect (if *_OAUTH_REDIRECT_URI is empty):
#   {API_PUBLIC_URL}/auth/oauth/{provider}/callback
# ---------------------------------------------------------------------------

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web)
# Authorized redirect URI example:
#   https://api.controlops.co.uk/auth/oauth/google/callback
#   http://localhost:8000/auth/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Azure Portal → App registrations → New registration
# Supported account types: Accounts in any org + personal Microsoft accounts (or set tenant)
# Redirect URI (Web) example:
#   https://api.controlops.co.uk/auth/oauth/microsoft/callback
# API permissions: Microsoft Graph → User.Read, openid, profile, email
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT_ID=common
MICROSOFT_OAUTH_REDIRECT_URI=

# Apple Developer → Certificates, Identifiers & Profiles
# 1) App ID with "Sign In with Apple"
# 2) Services ID (this is APPLE_OAUTH_CLIENT_ID) with return URL:
#   https://api.controlops.co.uk/auth/oauth/apple/callback
# 3) Key (Sign In with Apple) → download .p8
# Put PEM contents in APPLE_OAUTH_PRIVATE_KEY (use \n for newlines) OR absolute path to .p8
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=
APPLE_OAUTH_REDIRECT_URI=
